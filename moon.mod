// Learn more about moon.mod configuration:
// https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "tinyhttpd-moonbit/tinyhttpd"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/soehi/tinyhttpd-moonbit"

license = "GPL-2.0-or-later"

keywords = [ "http", "server", "cgi", "moonbit", "tinyhttpd" ]

preferred_target = "wasm"

description = "A tiny HTTP server in pure MoonBit, ported from J. David Blackstone's classic tinyhttpd (1999)."
